# Pukk - ESP-IDF v5.5.2, Waveshare ESP32-C6-Touch-AMOLED-2.16
# Only settings that differ from the IDF defaults. Do not commit a full sdkconfig.

#
# Target, flash, partitions
#
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# System
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# The board's USB-C port is the C6's built-in USB Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Crash dumps go to the "coredump" partition; read with `idf.py coredump-info`.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
