# Pukk - ESP-IDF v5.5.2, Waveshare ESP32-C6-Touch-AMOLED-2.16
# Only settings that differ from the IDF defaults. Do not commit a full sdkconfig.

#
# Target, flash, partitions
#
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# System
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# app_main builds the first screen, formats LittleFS on first boot and starts
# NimBLE; the 3.5 KB default is tight for that. Unused stack is logged.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# The board's USB-C port is the C6's built-in USB Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Crash dumps go to the "coredump" partition; read with `idf.py coredump-info`.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# Needed for the whole-system CPU load shown by the LVGL performance monitor.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

#
# LVGL 9 (configured through Kconfig, no lv_conf.h)
#
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
# LVGL's own heap (objects, styles), a static array in internal RAM.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_40=y
# FPS/CPU overlay (bottom right) and LVGL heap overlay (bottom left).
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_MEM_MONITOR=y

#
# Bluetooth: NimBLE host, BLE peripheral only (no Bluedroid)
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# No pairing/bonding in phase 0 (see docs/NOTES.md).
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
# 247 = one LL packet with Data Length Extension.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Pukk"
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Standard GATT services we do not use.
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n
