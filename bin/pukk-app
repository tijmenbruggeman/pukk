#!/usr/bin/env bash
# Run the Pukk web app locally, in the background.
#
#   bin/pukk-app start     build and start it on http://localhost:8080
#   bin/pukk-app stop      stop it
#   bin/pukk-app restart   stop, build and start again
#   bin/pukk-app status    is it running?
#   bin/pukk-app logs      follow the log (Ctrl-C to stop following)
#
# Settings from the environment:
#   PUKK_PASSWORD  password for the app (default: dev)
#   PORT           default 8080
#   HOST           default 127.0.0.1: only this computer; 0.0.0.0 for the network
#   PUKK_DATA_DIR  packs database, log and pid file (default: app/data)
#
# Needs Node 24. Packages are installed on the first start.
set -eo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
APP="$ROOT/app"
PORT=${PORT:-8080}
HOST=${HOST:-127.0.0.1}
DATA_DIR=${PUKK_DATA_DIR:-$APP/data}
PID_FILE="$DATA_DIR/app.pid"
LOG_FILE="$DATA_DIR/app.log"
START_TIMEOUT_S=15

die() {
    echo "fout: $*" >&2
    exit 1
}

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}

url() {
    if [ "$HOST" = 0.0.0.0 ]; then
        echo "http://localhost:$PORT"
    else
        echo "http://$HOST:$PORT" | sed 's/127\.0\.0\.1/localhost/'
    fi
}

# PID of our running server, or nothing. A stale pid file (process gone, or
# the number reused by something else) is removed.
running_pid() {
    [ -f "$PID_FILE" ] || return 0
    local pid
    pid=$(cat "$PID_FILE")
    if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q "dist/server.js"; then
        echo "$pid"
    else
        rm -f "$PID_FILE"
    fi
}

healthy() {
    curl -fsS --max-time 2 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1 ||
        curl -fsS --max-time 2 "http://[::1]:$PORT/healthz" >/dev/null 2>&1
}

check_node() {
    command -v node >/dev/null 2>&1 || die "node niet gevonden. Installeer Node 24 (bijv. brew install node@24)."
    local major
    major=$(node -p 'process.versions.node.split(".")[0]')
    [ "$major" -ge 24 ] || die "Node $(node -v) is te oud; de app heeft Node 24 nodig (node:sqlite)."
}

start() {
    local pid
    pid=$(running_pid)
    if [ -n "$pid" ]; then
        echo "De app draait al (pid $pid): $(url)"
        return 0
    fi
    check_node
    if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
        die "poort $PORT is al in gebruik: $(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN | awk 'NR == 2 {print $1 " (pid " $2 ")"}'). Kies een andere met PORT=…"
    fi

    cd "$APP"
    if [ ! -d node_modules ]; then
        echo "Packages installeren…"
        npm ci --no-audit --no-fund >/dev/null
    fi
    echo "Bouwen…"
    local build_log
    build_log=$(mktemp)
    if ! npm run build >"$build_log" 2>&1; then
        cat "$build_log" >&2
        rm -f "$build_log"
        die "bouwen mislukt"
    fi
    rm -f "$build_log"

    mkdir -p "$DATA_DIR"
    echo "--- $(date '+%Y-%m-%d %H:%M:%S') start" >>"$LOG_FILE"
    PUKK_PASSWORD=${PUKK_PASSWORD:-dev} PUKK_DATA_DIR="$DATA_DIR" PORT="$PORT" HOST="$HOST" \
        nohup node --disable-warning=ExperimentalWarning dist/server.js >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"

    local waited=0
    until healthy; do
        if [ -z "$(running_pid)" ]; then
            tail -n 20 "$LOG_FILE" >&2
            die "de app stopte meteen (log: $LOG_FILE)"
        fi
        if [ "$waited" -ge $((START_TIMEOUT_S * 10)) ]; then
            tail -n 20 "$LOG_FILE" >&2
            die "de app reageert niet na $START_TIMEOUT_S s (log: $LOG_FILE)"
        fi
        sleep 0.1
        waited=$((waited + 1))
    done

    echo "De app draait (pid $(cat "$PID_FILE")): $(url)"
    if [ -n "$PUKK_PASSWORD" ]; then
        echo "Wachtwoord: uit PUKK_PASSWORD"
    else
        echo "Wachtwoord: dev (een eigen kiezen: PUKK_PASSWORD=… bin/pukk-app restart)"
    fi
}

stop() {
    local pid
    pid=$(running_pid)
    if [ -z "$pid" ]; then
        echo "De app draait niet."
        return 0
    fi
    kill "$pid"
    local waited=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge 50 ]; then
            kill -9 "$pid" 2>/dev/null || true
            break
        fi
        sleep 0.1
        waited=$((waited + 1))
    done
    rm -f "$PID_FILE"
    echo "--- $(date '+%Y-%m-%d %H:%M:%S') stop" >>"$LOG_FILE"
    echo "De app is gestopt."
}

status() {
    local pid
    pid=$(running_pid)
    if [ -z "$pid" ]; then
        echo "De app draait niet."
        return 1
    fi
    if healthy; then
        echo "De app draait (pid $pid): $(url)"
    else
        echo "De app draait (pid $pid) maar reageert niet; zie bin/pukk-app logs"
        return 1
    fi
}

logs() {
    [ -f "$LOG_FILE" ] || die "nog geen log ($LOG_FILE)"
    tail -n 50 -f "$LOG_FILE"
}

case ${1:-} in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) status ;;
    logs) logs ;;
    -h|--help|help) usage 0 ;;
    *) usage 1 ;;
esac
