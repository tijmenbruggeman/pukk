{
  "name": "pukk-app",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Pukk web app: create quiz packs and push them to Pukk devices over Web Bluetooth.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "PUKK_PASSWORD=${PUKK_PASSWORD:-dev} PORT=8787 node --watch src/server/main.ts",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
